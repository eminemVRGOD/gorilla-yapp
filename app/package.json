{
  "name": "gorilla-yapps-desktop",
  "productName": "Gorilla Yapps",
  "version": "1.1.0",
  "description": "Gorilla Yapps desktop app",
  "author": "Gorilla Yapps",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.gorillayapps.desktop",
    "productName": "Gorilla Yapps",
    "icon": "icon.png",
    "files": ["main.js", "preload.js", "icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "artifactName": "GorillaYapps-Setup.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Gorilla Yapps" }
  }
}
